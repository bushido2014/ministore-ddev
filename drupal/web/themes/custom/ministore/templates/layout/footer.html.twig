{% if page.footer_first or page.footer_second or page.footer_third or page.footer_fourth or page.footer %}
  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <div class="site-footer__top">
        {% if page.footer_first %}
          <div class="site-footer__block site-footer__block--first">
            {{ page.footer_first }}
          </div>
        {% endif %}

        {% if page.footer_second %}
          <div class="site-footer__block site-footer__block--second">
            {{ page.footer_second }}
          </div>
        {% endif %}

        {% if page.footer_third %}
          <div class="site-footer__block site-footer__block--third">
            {{ page.footer_third }}
          </div>
        {% endif %}

        {% if page.footer_fourth %}
          <div class="site-footer__block site-footer__block--fourth">
            {{ page.footer_fourth }}
          </div>
        {% endif %}
      </div>

      <div class="site-footer__bottom">
        <div class="site-footer__brand">
          <a href="{{ url('<front>') }}" rel="home">{{ site_name }}</a>
        </div>

        {% if page.footer %}
          <div class="site-footer__meta">
            {{ page.footer }}
          </div>
        {% endif %}

        <div class="site-footer__copyright">
          &copy; {{ "now"|date("Y") }} {{ site_name }}. All rights reserved.
        </div>
      </div>
    </div>
  </footer>
{% endif %}
