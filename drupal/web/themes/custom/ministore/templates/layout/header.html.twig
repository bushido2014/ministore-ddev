{{ attach_library('ministore/mmenu') }}
<header class="header" id="header">
 
    <nav class="main-nav">
      <div class="container d-flex j-between">
         {{ page.header_left }}
          <div class="d-flex nav-desktop" id="mobile-menu">
         {% if page.primary_menu %}
        {{ page.primary_menu }}
        {% endif %}
         {{ page.header_right }}

         </div>
        
         {# Hamburger - doar mobile #}
      <button class="hamburger-btn" aria-label="Open menu">
        <i class="fa-solid fa-bars"></i>
      </button>
      </div>
    </nav>
  </header>
