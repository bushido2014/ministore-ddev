{{ attach_library('ministore/mmenu') }}

<header class="header" id="header">
  <nav class="main-nav">
    <div class="container d-flex j-between">

      {{ page.header_left }}

      {# Desktop menu #}
      <div class="d-flex">
      
     
        {% if page.primary_menu %}
        <div class="nav-desktop">
          {{ page.primary_menu }}
           </div>
        {% endif %}
      
        {{ page.header_right }}
        {# Mobile hamburger #}
      <button
        type="button"
        class="hamburger-btn"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false">
        <i class="fa-solid fa-bars"></i>
      </button>
      </div>


      

      {# Mobile menu #}
      <div class="nav-mobile" id="mobile-menu">
        {% if page.primary_menu %}
          {{ page.primary_menu }}
        {% endif %}
     
      </div>

    </div>
  </nav>
</header>