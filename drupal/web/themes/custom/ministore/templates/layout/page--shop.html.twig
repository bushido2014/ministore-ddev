<div class="shop-page">
  <div class="container">
    <div class="shop-layout">
      {# PRODUCTS #}
      <main class="shop-main">
        {{ page.content }}
      </main>  


      {# SIDEBAR #}
      <aside class="shop-sidebar">

        {# Search #}
        <div class="sidebar-widget">
          <h4>Search</h4>
          <div class="sidebar-search">
            {{ drupal_block('views_exposed_filter_block:shop-page_1') }}
          </div>
        </div>

        {# Categories #}
        <div class="sidebar-widget">
          <h4>Categories</h4>
          <ul class="sidebar-list">
            <li><a href="/shop">All</a></li>
          {#  {{ drupal_view('shop', 'block_categories') }} #}
          </ul>
        </div>

        {# Brands #}
        <div class="sidebar-widget">
          <h4>Brands</h4>
        {#  {{ drupal_view('shop', 'block_brands') }} #}
        </div>

        {# Tags #}
        <div class="sidebar-widget">
          <h4>Tags</h4>
        {#  {{ drupal_view('shop', 'block_tags') }} #}
        </div>

      </aside>

      

    </div>
  </div>
</div>