<article{{ attributes.addClass('blog-article') }}>

  <div class="container">
  


<h2>{{ node.title.value }}</h2>
<div class="article-img">
     {{content.field_image}}
 </div>

   {{ content.body }}


   <div class="article-tags">
   {{content.field_blog_tags}}
   </div>







  </div>
 
</article>