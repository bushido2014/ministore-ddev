{{ attach_library('ministore/gadget-slide') }}

{%
  set classes = [
    'gadget-products',
  ]
%}

<section {{ create_attribute().addClass(classes) }}>
<div class="container">

<div class="gadgets-products__haeading d-flex j-between">
  <div>
  {% if paragraph.field_mobile_product_title.value %}
      <h3 class="section-title">{{ paragraph.field_mobile_product_title.value }}</h3>
    {% endif %}
  </div>
  <div>
  {{content.field_mobile_product_link}}
  </div>
</div>

<div class="swiper gadget-slide">
      <div class="swiper-wrapper">

{% for item in paragraph.field_gadget_products %}
     <div class="swiper-slide">
 <a href="{{ path('entity.commerce_product.canonical', {'commerce_product': item.entity.id()}) }}" class="product-card">


      {# Imagine #}
      
      {% if item.entity.field_product_image.entity.field_media_image.entity.fileuri %}
        
        <img src="{{ file_url(item.entity.field_product_image.entity.field_media_image.entity.fileuri) }}"
             alt="{{ item.entity.title.value }}"
             loading="lazy">
            
      {% endif %}

      {# Titlu #}
      <h4 class="product-card__title">{{ item.entity.title.value }}</h4>

    </a>

</div>
{% endfor %}

</div>
</div>



</div>
</section>
