{%
  set classes = [
    'subscribe',
  ]
%}
<section {{ create_attribute().addClass(classes) }}>
  <div class="container">
    <div class="subscribe-content d-grid cols-2">
      <div class="subscribe-item">
      <h2 class="subscribe-title">{{paragraph.field_subscribe_tilte.value}}</h2>
    
      {{ paragraph.field_subscribe_text.processed }}
      </div>
      <div class="subscribe-item subscribe-form">
      {{content.field_subscribe_form}}
      </div>
    </div>
  </div>
</section>
