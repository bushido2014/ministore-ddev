<footer class="site-footer" role="contentinfo">
  <div class="container">

    {% if page.footer_top %}
      <div class="site-footer__top">
        {{ page.footer_top }}
      </div>
    {% endif %}

    {#  #}
    {% if page.footer %}
      {% set column_count = 0 %}
      {% for key, item in page.footer %}
        {% if key|first != '#' %}
          {% set column_count = column_count + 1 %}
        {% endif %}
      {% endfor %}
      <div class="site-footer__middle cols-{{ column_count }}">
        {{ page.footer }}
      </div>
    {% endif %}
<hr>
    <div class="site-footer__bottom d-flex j-between">
      <div class="site-footer__brand">
        <a href="{{ url('<front>') }}" rel="home">Ministore</a>
      </div>

      {% if page.footer_bottom %}
        <div class="site-footer__meta">
          {{ page.footer_bottom }}
        </div>
      {% endif %}

      <div class="site-footer__copyright">
         
        <p>&copy; {{ "now"|date("Y") }} {{ site_name }}. Design by <a href="https://templatesjungle.com/">TemplatesJungle</a>
              </p>
      </div>
    </div>

  </div>
</footer>
