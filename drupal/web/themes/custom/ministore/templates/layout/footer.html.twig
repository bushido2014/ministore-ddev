<footer class="site-footer" role="contentinfo">
  <div class="container">

    {% if page.footer_top %}
      <div class="site-footer__top">
        {{ page.footer_top }}
      </div>
    {% endif %}

    {# Coloane dinamice #}
    {% if page.footer %}
      {% set column_count = 0 %}
      {% for key, item in page.footer %}
        {% if key|first != '#' %}
          {% set column_count = column_count + 1 %}
        {% endif %}
      {% endfor %}
      <div class="site-footer__middle d-grid cols-{{ column_count }}">
        {{ page.footer }}
      </div>
    {% endif %}

    <div class="site-footer__bottom">
      <div class="site-footer__brand">
        <a href="{{ url('<front>') }}" rel="home">{{ site_name }}</a>
      </div>

      {% if page.footer_bottom %}
        <div class="site-footer__meta">
          {{ page.footer_bottom }}
        </div>
      {% endif %}

      <div class="site-footer__copyright">
        &copy; {{ "now"|date("Y") }} {{ site_name }}. All rights reserved.
      </div>
    </div>

  </div>
</footer>
