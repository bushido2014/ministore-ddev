<section class="about-us">
  <div class="container">

<div class="about-content d-grid cols-2">
    <div class="content-img">
{% set media = paragraph.field_about_us_image.entity %}
{% set image = media.field_media_image.entity %}
<img src="{{ file_url(image.uri.value) }}" alt="{{ media.field_media_image.alt }}" />
    </div>
    <div class="content-description">
        <h2>{{paragraph.field_about_title.value}}</h2>
        {{ paragraph.field_about_us_text.processed }}
        <div class="content-link">
             {{ content.field_sale_link }}
        </div>
    </div>
  </div>


    </div>
</section>