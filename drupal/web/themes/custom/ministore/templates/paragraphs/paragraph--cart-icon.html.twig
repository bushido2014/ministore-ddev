{%
  set classes = [
    'cart-icon-wrapp',
  ]
%}
 
<div{{ create_attribute().addClass(classes) }}>

  
  {% set cart_url = paragraph.field_cart_icon_link.0.url %}

  
  {% set icon_name = paragraph.field_cart_icon.0.icon_name|default('cart-shopping') %}

  {% if cart_url %}
    <a href="{{ cart_url }}" class="social-icon-link" aria-label="View cart">
      <i class="fa-solid fa-{{ icon_name }}"></i>
    </a>
  {% else %}
    <span class="social-icon-link">
      <i class="fa-solid fa-{{ icon_name }}"></i>
    </span>
  {% endif %}

</div>

