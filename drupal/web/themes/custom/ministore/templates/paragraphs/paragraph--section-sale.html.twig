{%
  set classes = [
    'yearle-sale bg-light',
  ]
%}
<section {{ create_attribute().addClass(classes) }}
{% if paragraph.field_sale_img.entity %}
    {% set media = paragraph.field_sale_img.entity %}
    {% set image = media.field_media_image.entity %}
    {% if image %}
      style="background-image: url('{{ file_url(image.uri.value) }}')"
    {% endif %}
  {% endif %}

>
  <div class="container">
     <div class="sale-content">
      <h3>{{paragraph.field_sale_before_text.value}}</h3>
      <h2>{{paragraph.field_sale_title.value}}</h2>
      {% if content.field_sale_link %}
    <div class="sale-link">
      {{ content.field_sale_link }}
    </div>
  {% endif %}
     </div>
  </div>
</section>
